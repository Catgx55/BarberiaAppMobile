<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_caballero"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvNombreServicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="Fade clásico"
        android:textColor="@color/caballero_text"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/tvDescripcionServicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Descripción del servicio"
        android:textColor="@color/caballero_muted"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="@color/caballero_line" />

    <TextView
        android:id="@+id/tvPrecioDuracion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="30 min  •  $25.000"
        android:textColor="@color/caballero_gold"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>