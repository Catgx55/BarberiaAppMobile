<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/tvCitaCliente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cliente_1"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCitaDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/fecha_hora_barbero_pago"
        android:textSize="14sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvCitaEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/estado_actual_pendiente"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <Button
        android:id="@+id/btnCambiarEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cambiar_estado"
        android:layout_marginTop="6dp" />

</LinearLayout>