<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_caballero"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvNombreBarbero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="Nombre del barbero"
        android:textColor="@color/caballero_text"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/tvEspecialidadBarbero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Barbero profesional"
        android:textColor="@color/caballero_gold"
        android:textSize="13sp" />

</LinearLayout>