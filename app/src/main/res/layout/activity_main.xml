<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/caballero_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="16dp">

    <!-- Encabezado de marca igual a la web -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_brand_mark"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="C."
            android:textColor="@color/caballero_gold"
            android:textSize="21sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="EL CABALLERO"
                android:textColor="@color/caballero_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.12"
                android:text="BARBERÍA · ARMENIA"
                android:textColor="@color/caballero_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPanelAdmin"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_input_caballero"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="Panel Barbero"
            android:textAllCaps="false"
            android:textColor="@color/caballero_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"
        android:background="@color/caballero_line" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.16"
        android:text="DESDE 2024 · ARMENIA, QUINDÍO"
        android:textColor="@color/caballero_gold"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="serif"
        android:text="El arte de un buen corte."
        android:textColor="@color/caballero_text"
        android:textSize="28sp" />

    <!-- Botón principal dorado -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnIrAgendar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_button_gold"
        android:text="Reservar mi cita ↗"
        android:textAllCaps="false"
        android:textColor="@color/caballero_dark_ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Fila de botones catálogo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCargarServicios"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_caballero"
            android:text="Servicios"
            android:textAllCaps="false"
            android:textColor="@color/caballero_gold"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCargarBarberos"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_caballero"
            android:text="Barberos"
            android:textAllCaps="false"
            android:textColor="@color/caballero_gold"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Toca Servicios o Barberos para explorar el catálogo"
        android:textColor="@color/caballero_muted"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvServicios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>