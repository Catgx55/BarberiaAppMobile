<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agendar Cita"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etFirstName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/nombre_ej_juan"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/etLastName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/apellido_ej_p_rez"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/correo_ej_juan_correo_com"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/tel_fono_ej_3001234567"
            android:inputType="phone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/selecciona_barbero"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

        <Spinner
            android:id="@+id/spBarbero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/selecciona_servicio"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

        <Spinner
            android:id="@+id/spServicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/toca_para_elegir_fecha_yyyy_mm_dd"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etHora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/toca_para_elegir_hora_hh_mm"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/m_todo_de_pago"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

        <Spinner
            android:id="@+id/spPago"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etNotas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/notas_adicionales_opcional"
            android:inputType="textMultiLine" />

        <Button
            android:id="@+id/btnConfirmarCita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/confirmar_cita"
            android:layout_marginTop="14dp" />

        <TextView
            android:id="@+id/tvEstadoCita"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>